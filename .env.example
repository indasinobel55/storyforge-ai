# ---------------------------------------------------------------------------
# Backend (FastAPI). Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------
APP_NAME=StoryForge AI
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional explicit Fernet key. If empty, a key is derived from SECRET_KEY.
# SESSION_ENCRYPTION_KEY=
SESSION_TTL_HOURS=336
WS_TICKET_TTL_SECONDS=120
SIGNED_URL_TTL_SECONDS=900
COOKIE_SECURE=false
AUTO_CREATE_SCHEMA=true
# Must be false in production.
DEV_EXPOSE_RESET_TOKEN=true

# SQLite (default, zero setup) or Postgres.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/storyforge
DATABASE_URL=sqlite+aiosqlite:///./data/studio.db
STORAGE_DIR=./data/storage

# ---------------------------------------------------------------------------
# Execution mode: cloud | local
# cloud = the backend worker service claims jobs (workers/runner.py)
# local = a connected computer runs `python -m local_agent`
# ---------------------------------------------------------------------------
EXECUTION_MODE=cloud

# Simulated provider (development / automated tests). Renders real MP4 clips
# and is always labelled as simulated.
SIMULATED_PROVIDER_ENABLED=true
SIMULATED_GENERATION_SECONDS=1.5
SIMULATED_CLIP_SECONDS=2.0

# Real TAAFT automation is disabled pending written provider authorization.
# See TAAFT_INTEGRATION_FEASIBILITY.md and the TAAFT Terms of Service.
TAAFT_ENABLED=false
TAAFT_POLL_SECONDS=20
TAAFT_JOB_TIMEOUT_SECONDS=3600
TAAFT_HEADLESS=true
# TAAFT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional planning LLM (falls back to the deterministic planner).
PLANNER_LLM_ENABLED=false
PLANNER_LLM_URL=https://text.pollinations.ai/openai
PLANNER_LLM_TIMEOUT_SECONDS=180

# Worker + queue
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=90
WORKER_MAX_ATTEMPTS=3
WORKER_ID_PREFIX=worker
MAX_ACTIVE_PROJECTS_PER_USER=1
MAX_SCENES_PER_PROJECT=20
MAX_REFERENCE_UPLOAD_MB=12
MAX_SCENE_SECONDS=10
USAGE_STORAGE_QUOTA_MB=2048

# Optional S3-compatible storage (Cloudflare R2 free tier works).
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=storyforge
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ---------------------------------------------------------------------------
# Local agent (set in the shell that runs `python -m local_agent`)
# ---------------------------------------------------------------------------
STUDIO_API_URL=http://localhost:8000
# Prefer the environment variable over --token so the token is not in history.
LOCAL_EXECUTION_TOKEN=
LOCAL_WORK_DIR=local_work
LOCAL_PLANNER_LLM=0
# Real TAAFT automation remains gated even for the local worker.
TAAFT_LOCAL_ENABLED=0
# TAAFT_STORAGE_STATE=./data/taaft_state.json
